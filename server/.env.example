DATABASE_URL="postgresql://user:password@localhost:5432/asterops?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
PORT=4000
NODE_ENV="development"

# Stripe (optional in dev — checkout falls back to a simulated payment when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Seed admin account (created by `npm run prisma:seed`)
SEED_ADMIN_EMAIL="admin@asterops.com"
SEED_ADMIN_PASSWORD="change-me-now"
