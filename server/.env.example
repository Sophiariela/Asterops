DATABASE_URL="postgresql://user:password@localhost:5432/asterops?schema=public"
# Neon (or any provider with a separate pooled/direct URL): use the pooled URL above for
# DATABASE_URL and the direct/unpooled URL for DIRECT_URL — Prisma Migrate needs the latter.
DIRECT_URL="postgresql://user:password@localhost:5432/asterops?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
PORT=4000
NODE_ENV="development"

# Stripe (optional in dev — checkout falls back to a simulated payment when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# WebOS Business Operations — all optional. Every feature below degrades to
# a harmless console.log (or a 503 on the connect endpoint, for Google
# Calendar) when its vars are unset, so the app runs fully without them.

# Resend (transactional email — lead/reservation/review notifications,
# reservation confirmations). Get a key at https://resend.com.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="AsterOps <notifications@asterops.app>"

# Twilio (SMS — Premium sites only: reservation confirmations/cancellations
# texted to guests). Get credentials at https://twilio.com/console.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Meta WhatsApp Cloud API (Premium sites only: reservation alerts sent to
# each site's own WhatsApp Number from Business Settings). Set up at
# https://developers.facebook.com/docs/whatsapp/cloud-api.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Google Calendar (Premium sites only: each site owner connects their own
# calendar via OAuth from Business Settings). Create an OAuth client at
# https://console.cloud.google.com — GOOGLE_REDIRECT_URI must exactly match
# the API's own origin + /api/webos/google-calendar/callback, and be
# registered as an authorized redirect URI on that OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/webos/google-calendar/callback"

# Seed admin account (created by `npm run prisma:seed`)
SEED_ADMIN_EMAIL="admin@asterops.com"
SEED_ADMIN_PASSWORD="change-me-now"
