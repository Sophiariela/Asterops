generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DeploymentStage {
  PENDING
  IN_REVIEW
  DEPLOYING
  COMPLETED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum CommerceOrderStatus {
  PENDING
  PROCESSING
  FULFILLED
  CANCELLED
  REFUNDED
}

enum CommerceOrderChannel {
  ONLINE
  POS
  MANUAL
}

enum StockMovementReason {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
}

enum SitePlaybook {
  LOCAL_BUSINESS
  SAAS
  ECOMMERCE
  CONSULTANT
  AGENCY
  RESTAURANT
  FITNESS
  CREATOR
  PERSONAL_BRAND
  PROFESSIONAL_SERVICES
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
}

enum TemplateComplexity {
  SIMPLE
  STANDARD
  ADVANCED
}

enum TrustElementType {
  CASE_STUDY
  CLIENT_LOGO
  CERTIFICATION
}

enum SiteCurrency {
  USD
  BRL
  EUR
  GBP
  INR
  CAD
  AUD
}

enum SiteStatus {
  DRAFT
  PUBLISHED
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONVERTED
  LOST
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  passwordHash        String
  name                String?
  role                Role                  @default(CUSTOMER)
  stripeCustomerId    String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  orders              Order[]
  onboarding          OnboardingSubmission?
  passwordResetTokens PasswordResetToken[]

  // CommerceOS — this User is the tenant/owner of everything below.
  categories          Category[]         @relation("CategoryOwner")
  products            Product[]          @relation("ProductOwner")
  commerceCustomers   CommerceCustomer[] @relation("CommerceCustomerOwner")
  commerceOrders      CommerceOrder[]    @relation("CommerceOrderOwner")
  stockMovements      StockMovement[]    @relation("StockMovementOwner")

  // WebOS — this User is the tenant/owner of everything below.
  sites               Site[]             @relation("SiteOwner")
}

model Plan {
  id                   String     @id @default(cuid())
  name                 String
  slug                 String     @unique
  description          String
  features             String[]
  price                Int
  annualPrice          Int?
  stripeProductId      String?
  stripeMonthlyPriceId String?
  stripeAnnualPriceId  String?
  status               PlanStatus @default(ACTIVE)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  orders               Order[]
}

model Order {
  id         String            @id @default(cuid())
  customer   User              @relation(fields: [customerId], references: [id])
  customerId String
  plan       Plan              @relation(fields: [planId], references: [id])
  planId     String
  amount     Int
  status     OrderStatus       @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  payment    Payment?
  deployment DeploymentStatus?

  @@index([customerId])
}

model Payment {
  id          String        @id @default(cuid())
  order       Order         @relation(fields: [orderId], references: [id])
  orderId     String        @unique
  provider    String        @default("stripe")
  providerRef String?
  amount      Int
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model OnboardingSubmission {
  id              String   @id @default(cuid())
  customer        User     @relation(fields: [customerId], references: [id])
  customerId      String   @unique
  companyName     String
  businessType    String
  websiteUrl      String?
  instagram       String?
  primaryGoal     String
  targetAudience  String
  brandColors     String?
  logoUrl         String?
  brandAssetUrls  String[]
  additionalNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DeploymentStatus {
  id        String          @id @default(cuid())
  order     Order           @relation(fields: [orderId], references: [id])
  orderId   String          @unique
  status    DeploymentStage @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------
// CommerceOS — Phase 1 (Products, Categories, Inventory, Orders, Customers)
//
// Scoped to a User (the ASTER account holder) via `ownerId`, since there is
// no Organization/multi-tenant model yet. "CommerceOrder"/"CommerceCustomer"
// are prefixed to avoid colliding with the existing platform-billing
// `Order` model above, which represents an ASTER plan purchase, not a
// tenant's own sale.
// ---------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  owner       User      @relation("CategoryOwner", fields: [ownerId], references: [id])
  ownerId     String
  name        String
  slug        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ownerId, slug])
  @@index([ownerId])
}

model Product {
  id             String               @id @default(cuid())
  owner          User                 @relation("ProductOwner", fields: [ownerId], references: [id])
  ownerId        String
  category       Category?            @relation(fields: [categoryId], references: [id])
  categoryId     String?
  name           String
  slug           String
  sku            String
  description    String?
  price          Int
  compareAtPrice Int?
  costPrice      Int?
  status         ProductStatus        @default(ACTIVE)
  stockQuantity  Int                  @default(0)
  reorderPoint   Int                  @default(0)
  imageUrl       String?
  orderItems     CommerceOrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([ownerId, sku])
  @@unique([ownerId, slug])
  @@index([ownerId])
  @@index([categoryId])
}

model CommerceCustomer {
  id        String          @id @default(cuid())
  owner     User            @relation("CommerceCustomerOwner", fields: [ownerId], references: [id])
  ownerId   String
  name      String
  email     String?
  phone     String?
  notes     String?
  orders    CommerceOrder[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([ownerId])
}

model CommerceOrder {
  id         String               @id @default(cuid())
  owner      User                 @relation("CommerceOrderOwner", fields: [ownerId], references: [id])
  ownerId    String
  customer   CommerceCustomer     @relation(fields: [customerId], references: [id])
  customerId String
  status     CommerceOrderStatus  @default(PENDING)
  channel    CommerceOrderChannel @default(MANUAL)
  subtotal   Int
  total      Int
  notes      String?
  items      CommerceOrderItem[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([ownerId])
  @@index([customerId])
}

model CommerceOrderItem {
  id        String        @id @default(cuid())
  order     CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product       @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Int
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([productId])
}

model StockMovement {
  id        String               @id @default(cuid())
  owner     User                 @relation("StockMovementOwner", fields: [ownerId], references: [id])
  ownerId   String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  change    Int
  reason    StockMovementReason
  note      String?
  createdAt DateTime             @default(now())

  @@index([ownerId])
  @@index([productId])
}

// ---------------------------------------------------------------------
// WebOS — Site Generator, Pages, Trust Engine, Leads
//
// There is no live public hosting yet: a Site's Pages are dashboard-
// managed content, not a served URL. Health Score, Conversion Audit and
// the Trust Engine all evaluate this content directly, so they're real
// from day one. Anything that needs actual visitor traffic (page views,
// bounce rate, a "Visitors" funnel stage) has no data source until public
// rendering exists — that's a separate, later piece of work.
// ---------------------------------------------------------------------

model Site {
  id              String         @id @default(cuid())
  owner           User           @relation("SiteOwner", fields: [ownerId], references: [id])
  ownerId         String
  businessName    String
  industry        String
  targetAudience  String
  logoUrl         String?
  currency        SiteCurrency   @default(USD)
  country         String?
  timezone        String?
  playbook        SitePlaybook
  template        Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId      String?
  templateVersion Int?
  status          SiteStatus     @default(DRAFT)
  pages           Page[]
  testimonials    Testimonial[]
  leads           Lead[]
  trustElements   TrustElement[]
  tables          Table[]
  reservations    Reservation[]
  menuCategories  MenuCategory[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([ownerId])
  @@index([templateId])
}

// ---------------------------------------------------------------------
// WebOS Template Library — the recipe layer that Site/Page (above) is
// generated from. Deliberately reuses Site/Page as the "generated
// website" storage instead of separate GeneratedWebsite/GeneratedPage
// tables, since Site/Page already carry every downstream feature
// (blueprint analytics, leads, trust, Luna) a duplicate model would
// have to reimplement from scratch. Site.templateId/templateVersion
// is the generated-website's provenance link back to the template
// (and version) it came from.
// ---------------------------------------------------------------------

model Template {
  id                 String              @id @default(cuid())
  key                SitePlaybook
  name               String
  industry           String
  primaryGoal        String
  complexity         TemplateComplexity
  description        String
  recommendedUseCase String
  isEcommerce        Boolean             @default(false)
  status             TemplateStatus      @default(DRAFT)
  version            Int                 @default(1)
  parentTemplate     Template?           @relation("TemplateVersions", fields: [parentTemplateId], references: [id], onDelete: SetNull)
  parentTemplateId   String?
  versions           Template[]          @relation("TemplateVersions")
  pages              TemplatePage[]
  sites              Site[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([key])
  @@index([status])
}

model TemplatePage {
  id                     String            @id @default(cuid())
  template               Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId             String
  slug                   String
  name                   String
  order                  Int
  purpose                String
  heroHeadlinePattern    String
  heroSubheadlinePattern String
  ctaLabel               String
  hasLeadForm            Boolean           @default(false)
  seoTitlePattern        String?
  seoDescriptionPattern  String?
  sections               TemplateSection[]

  @@unique([templateId, slug])
  @@index([templateId])
}

model TemplateSection {
  id             String       @id @default(cuid())
  page           TemplatePage @relation(fields: [templatePageId], references: [id], onDelete: Cascade)
  templatePageId String
  type           String
  heading        String
  bodyPattern    String
  order          Int

  @@index([templatePageId])
}

model Page {
  id              String   @id @default(cuid())
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId          String
  slug            String
  name            String
  heroHeadline    String
  heroSubheadline String
  heroImageUrl    String?
  ctaLabel        String
  ctaHref         String?
  sections        Json
  seoTitle        String?
  seoDescription  String?
  hasLeadForm     Boolean  @default(false)
  order           Int      @default(0)
  leads           Lead[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId])
}

model Testimonial {
  id         String   @id @default(cuid())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId     String
  authorName String
  authorRole String?
  quote      String
  rating     Int?
  createdAt  DateTime @default(now())

  @@index([siteId])
}

model Lead {
  id        String     @id @default(cuid())
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  page      Page?      @relation(fields: [pageId], references: [id])
  pageId    String?
  name      String?
  email     String
  message   String?
  source    String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([siteId])
}

// Case studies, client logos and certifications — the Trust Map's other
// categories beyond Testimonial. One flexible model rather than three
// rigid tables, since each is just a title/description/optional link.
model TrustElement {
  id          String           @id @default(cuid())
  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId      String
  type        TrustElementType
  title       String
  description String?
  url         String?
  createdAt   DateTime         @default(now())

  @@index([siteId])
}

// ---------------------------------------------------------------------
// Restaurant vertical — a real reservation system and menu manager,
// replacing the generic lead-capture form and text-bullet "menu"
// section on the Restaurant template. Reservation/Table/MenuCategory/
// MenuItem are plain Site-scoped models (not gated to one playbook at
// the schema level) so nothing here is a special case in the database —
// only the Restaurant template's generated pages and the frontend UI
// surface them.
// ---------------------------------------------------------------------

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Table {
  id           String        @id @default(cuid())
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId       String
  name         String
  capacity     Int
  reservations Reservation[]
  createdAt    DateTime      @default(now())

  @@index([siteId])
}

// reservationAt + durationMinutes (a fixed default seating length, not a
// measurement) is what makes table-conflict checking possible without
// a separate "end time" the customer would have to guess at submission.
model Reservation {
  id              String            @id @default(cuid())
  site            Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId          String
  table           Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableId         String?
  customerName    String
  customerEmail   String
  customerPhone   String?
  partySize       Int
  reservationAt   DateTime
  durationMinutes Int               @default(90)
  status          ReservationStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([siteId])
  @@index([tableId])
}

model MenuCategory {
  id        String     @id @default(cuid())
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  name      String
  order     Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())

  @@index([siteId])
}

// priceCents is nullable — a freshly generated item has a real name (the
// business's own entered offering) but no fabricated price; the Menu
// Manager shows "Add price" until the owner sets one.
model MenuItem {
  id          String       @id @default(cuid())
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  name        String
  description String?
  priceCents  Int?
  imageUrl    String?
  available   Boolean      @default(true)
  featured    Boolean      @default(false)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
}
