generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DeploymentStage {
  PENDING
  IN_REVIEW
  DEPLOYING
  COMPLETED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum CommerceOrderStatus {
  PENDING
  PROCESSING
  FULFILLED
  CANCELLED
  REFUNDED
}

enum CommerceOrderChannel {
  ONLINE
  POS
  MANUAL
}

enum StockMovementReason {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  passwordHash        String
  name                String?
  role                Role                  @default(CUSTOMER)
  stripeCustomerId    String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  orders              Order[]
  onboarding          OnboardingSubmission?
  passwordResetTokens PasswordResetToken[]

  // CommerceOS — this User is the tenant/owner of everything below.
  categories          Category[]         @relation("CategoryOwner")
  products            Product[]          @relation("ProductOwner")
  commerceCustomers   CommerceCustomer[] @relation("CommerceCustomerOwner")
  commerceOrders      CommerceOrder[]    @relation("CommerceOrderOwner")
  stockMovements      StockMovement[]    @relation("StockMovementOwner")
}

model Plan {
  id                   String     @id @default(cuid())
  name                 String
  slug                 String     @unique
  description          String
  features             String[]
  price                Int
  annualPrice          Int?
  stripeProductId      String?
  stripeMonthlyPriceId String?
  stripeAnnualPriceId  String?
  status               PlanStatus @default(ACTIVE)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  orders               Order[]
}

model Order {
  id         String            @id @default(cuid())
  customer   User              @relation(fields: [customerId], references: [id])
  customerId String
  plan       Plan              @relation(fields: [planId], references: [id])
  planId     String
  amount     Int
  status     OrderStatus       @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  payment    Payment?
  deployment DeploymentStatus?

  @@index([customerId])
}

model Payment {
  id          String        @id @default(cuid())
  order       Order         @relation(fields: [orderId], references: [id])
  orderId     String        @unique
  provider    String        @default("stripe")
  providerRef String?
  amount      Int
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model OnboardingSubmission {
  id              String   @id @default(cuid())
  customer        User     @relation(fields: [customerId], references: [id])
  customerId      String   @unique
  companyName     String
  businessType    String
  websiteUrl      String?
  instagram       String?
  primaryGoal     String
  targetAudience  String
  brandColors     String?
  logoUrl         String?
  brandAssetUrls  String[]
  additionalNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DeploymentStatus {
  id        String          @id @default(cuid())
  order     Order           @relation(fields: [orderId], references: [id])
  orderId   String          @unique
  status    DeploymentStage @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------
// CommerceOS — Phase 1 (Products, Categories, Inventory, Orders, Customers)
//
// Scoped to a User (the ASTER account holder) via `ownerId`, since there is
// no Organization/multi-tenant model yet. "CommerceOrder"/"CommerceCustomer"
// are prefixed to avoid colliding with the existing platform-billing
// `Order` model above, which represents an ASTER plan purchase, not a
// tenant's own sale.
// ---------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  owner       User      @relation("CategoryOwner", fields: [ownerId], references: [id])
  ownerId     String
  name        String
  slug        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ownerId, slug])
  @@index([ownerId])
}

model Product {
  id             String               @id @default(cuid())
  owner          User                 @relation("ProductOwner", fields: [ownerId], references: [id])
  ownerId        String
  category       Category?            @relation(fields: [categoryId], references: [id])
  categoryId     String?
  name           String
  slug           String
  sku            String
  description    String?
  price          Int
  compareAtPrice Int?
  status         ProductStatus        @default(ACTIVE)
  stockQuantity  Int                  @default(0)
  reorderPoint   Int                  @default(0)
  imageUrl       String?
  orderItems     CommerceOrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([ownerId, sku])
  @@unique([ownerId, slug])
  @@index([ownerId])
  @@index([categoryId])
}

model CommerceCustomer {
  id        String          @id @default(cuid())
  owner     User            @relation("CommerceCustomerOwner", fields: [ownerId], references: [id])
  ownerId   String
  name      String
  email     String?
  phone     String?
  notes     String?
  orders    CommerceOrder[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([ownerId])
}

model CommerceOrder {
  id         String               @id @default(cuid())
  owner      User                 @relation("CommerceOrderOwner", fields: [ownerId], references: [id])
  ownerId    String
  customer   CommerceCustomer     @relation(fields: [customerId], references: [id])
  customerId String
  status     CommerceOrderStatus  @default(PENDING)
  channel    CommerceOrderChannel @default(MANUAL)
  subtotal   Int
  total      Int
  notes      String?
  items      CommerceOrderItem[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([ownerId])
  @@index([customerId])
}

model CommerceOrderItem {
  id        String        @id @default(cuid())
  order     CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product       @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Int
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([productId])
}

model StockMovement {
  id        String               @id @default(cuid())
  owner     User                 @relation("StockMovementOwner", fields: [ownerId], references: [id])
  ownerId   String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  change    Int
  reason    StockMovementReason
  note      String?
  createdAt DateTime             @default(now())

  @@index([ownerId])
  @@index([productId])
}
