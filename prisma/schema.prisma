generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InquiryStatus {
  NEW
  CONTACTED
  DISCOVERY
  PROPOSAL_SENT
  IN_PROGRESS
  COMPLETED
  LOST
}

enum ProjectClassification {
  CLIENT_PROJECT
  INTERNAL_PRODUCT
  PROTOTYPE
}

enum ProjectStatus {
  LIVE
  DELIVERED
  IN_PROGRESS
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  icon        String   @default("Sparkles")
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

model PortfolioProject {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  category         String
  shortDescription String
  fullDescription  String
  coverImage       String?
  gallery          String[]               @default([])
  projectUrl       String?
  technologies     String[]               @default([])
  classification   ProjectClassification  @default(CLIENT_PROJECT)
  status           ProjectStatus          @default(DELIVERED)
  published        Boolean                @default(true)
  order            Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([published, order])
}

model Inquiry {
  id           String        @id @default(cuid())
  name         String
  email        String
  whatsapp     String?
  businessName String?
  /// Segmento informado pelo lead ("Salão de beleza", "Studio de unhas"…).
  businessType String?
  service      String?
  budget       String?
  /// "O que você precisa" — descrição do pedido.
  message      String
  /// "Qual é o problema hoje" — a dor operacional, separada do pedido.
  problem      String?
  timeline     String?
  status       InquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  notes        InquiryNote[]

  @@index([status, createdAt])
  // Usado pela trava de envio duplicado em /api/contact.
  @@index([email, createdAt])
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model SiteSettings {
  id           String   @id @default("default")
  studioName   String   @default("Aster")
  contactEmail String   @default("contato@aster.studio")
  whatsapp     String?
  /// Mensagem que já vem escrita ao abrir o WhatsApp a partir do site.
  whatsappMessage String @default("Oi! Vim pelo site da Aster e quero automatizar meu negócio.")
  instagramUrl String?
  ctaLabel     String   @default("Solicitar diagnóstico")
  ctaHref      String   @default("/contato")
  footerNote   String   @default("Tecnologia implementada para o seu negócio agendar, responder e vender.")

  // Hero editável pelo painel — ver /admin/settings.
  heroEyebrow       String @default("Estúdio de automação e software")
  heroHeadline      String @default("Seu negócio agenda, responde e vende. Sem você precisar fazer tudo manualmente.")
  heroSubheadline   String @default("Sites profissionais, agendamento online, WhatsApp automatizado e sistemas personalizados. Nós configuramos a tecnologia para você.")
  heroPrimaryCta    String @default("Quero automatizar meu negócio")
  heroSecondaryCta  String @default("Ver o que podemos fazer")

  updatedAt    DateTime @updatedAt
}

/// Os três níveis comerciais (Presença, Agenda, Operação). Ficam no banco
/// para que preço e escopo sejam editados pelo painel — o site nunca
/// inventa valor: sem preço definido, mostra "Solicite uma proposta".
model SolutionTier {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  /// Para quem é.
  audience       String
  /// Que problema resolve.
  problem        String
  /// Resultado principal, na voz do cliente.
  outcome        String
  inclusions     String[] @default([])
  /// O que é customizado caso a caso.
  customization  String
  /// Como a implementação acontece.
  implementation String
  priceLabel     String   @default("Solicite uma proposta personalizada.")
  /// Taxa de implementação — cobrada à parte, explicada no cartão.
  setupLabel     String   @default("Implementação sob escopo, orçada no diagnóstico.")
  featured       Boolean  @default(false)
  published      Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, order])
}

model FaqEntry {
  id        String   @id @default(cuid())
  question  String
  answer    String
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}
