[
  {
    "name": "theme_info",
    "theme_name": "ASTER",
    "theme_version": "1.1.0",
    "theme_author": "AsterOps",
    "theme_documentation_url": "https://asterops.dev/docs/aster",
    "theme_support_url": "https://asterops.dev/support"
  },
  {
    "name": "t:settings.global.name",
    "settings": [
      {
        "type": "select",
        "id": "niche_preset",
        "label": "t:settings.global.niche_preset.label",
        "info": "t:settings.global.niche_preset.info",
        "options": [
          { "value": "luxury", "label": "t:settings.global.niche_preset.options.luxury" },
          { "value": "jewelry", "label": "t:settings.global.niche_preset.options.jewelry" },
          { "value": "fashion", "label": "t:settings.global.niche_preset.options.fashion" },
          { "value": "beauty", "label": "t:settings.global.niche_preset.options.beauty" },
          { "value": "handmade", "label": "t:settings.global.niche_preset.options.handmade" }
        ],
        "default": "luxury"
      }
    ]
  },
  {
    "name": "t:settings.colors.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.colors.background_header"
      },
      { "type": "color", "id": "color_background", "label": "t:settings.colors.background", "default": "#FAF8F5" },
      { "type": "color", "id": "color_background_secondary", "label": "t:settings.colors.background_secondary", "default": "#F1ECE3" },
      { "type": "color", "id": "color_text", "label": "t:settings.colors.text", "default": "#1C1B19" },
      { "type": "color", "id": "color_text_muted", "label": "t:settings.colors.text_muted", "default": "#6B6558" },
      {
        "type": "header",
        "content": "t:settings.colors.accent_header"
      },
      { "type": "color", "id": "color_primary", "label": "t:settings.colors.primary", "default": "#9C7A3C" },
      { "type": "color", "id": "color_primary_text", "label": "t:settings.colors.primary_text", "default": "#FFFFFF" },
      { "type": "color", "id": "color_secondary", "label": "t:settings.colors.secondary", "default": "#1C1B19" },
      { "type": "color", "id": "color_secondary_text", "label": "t:settings.colors.secondary_text", "default": "#FFFFFF" },
      {
        "type": "header",
        "content": "t:settings.colors.utility_header"
      },
      { "type": "color", "id": "color_border", "label": "t:settings.colors.border", "default": "#E4DECF" },
      { "type": "color", "id": "color_sale", "label": "t:settings.colors.sale", "default": "#B3492B" },
      { "type": "color", "id": "color_success", "label": "t:settings.colors.success", "default": "#3E6B4F" },
      { "type": "color", "id": "color_star", "label": "t:settings.colors.star", "default": "#9C7A3C" }
    ]
  },
  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.typography.headings_header"
      },
      { "type": "font_picker", "id": "font_heading", "label": "t:settings.typography.font", "default": "playfair_display_n4" },
      { "type": "range", "id": "font_heading_scale", "label": "t:settings.typography.scale", "min": 90, "max": 150, "step": 5, "unit": "%", "default": 110 },
      {
        "type": "select",
        "id": "font_heading_case",
        "label": "t:settings.typography.letter_case",
        "options": [
          { "value": "none", "label": "t:settings.typography.letter_case_options.none" },
          { "value": "uppercase", "label": "t:settings.typography.letter_case_options.uppercase" }
        ],
        "default": "none"
      },
      {
        "type": "header",
        "content": "t:settings.typography.body_header"
      },
      { "type": "font_picker", "id": "font_body", "label": "t:settings.typography.font", "default": "assistant_n4" },
      { "type": "range", "id": "font_body_scale", "label": "t:settings.typography.scale", "min": 90, "max": 130, "step": 5, "unit": "%", "default": 100 }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      { "type": "range", "id": "page_width", "label": "t:settings.layout.page_width", "min": 1200, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
      { "type": "range", "id": "grid_gutter", "label": "t:settings.layout.grid_gutter", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 24 },
      { "type": "range", "id": "spacing_sections", "label": "t:settings.layout.spacing_sections", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
      {
        "type": "select",
        "id": "corner_radius",
        "label": "t:settings.layout.corner_radius",
        "options": [
          { "value": "0", "label": "t:settings.layout.corner_radius_options.sharp" },
          { "value": "4", "label": "t:settings.layout.corner_radius_options.soft" },
          { "value": "12", "label": "t:settings.layout.corner_radius_options.rounded" }
        ],
        "default": "0"
      }
    ]
  },
  {
    "name": "t:settings.buttons.name",
    "settings": [
      {
        "type": "select",
        "id": "button_style",
        "label": "t:settings.buttons.style",
        "options": [
          { "value": "solid", "label": "t:settings.buttons.style_options.solid" },
          { "value": "outline", "label": "t:settings.buttons.style_options.outline" },
          { "value": "text", "label": "t:settings.buttons.style_options.text" }
        ],
        "default": "solid"
      },
      {
        "type": "select",
        "id": "button_case",
        "label": "t:settings.typography.letter_case",
        "options": [
          { "value": "none", "label": "t:settings.typography.letter_case_options.none" },
          { "value": "uppercase", "label": "t:settings.typography.letter_case_options.uppercase" }
        ],
        "default": "uppercase"
      }
    ]
  },
  {
    "name": "t:settings.product_cards.name",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "t:settings.product_cards.image_ratio",
        "options": [
          { "value": "portrait", "label": "t:settings.product_cards.image_ratio_options.portrait" },
          { "value": "square", "label": "t:settings.product_cards.image_ratio_options.square" },
          { "value": "landscape", "label": "t:settings.product_cards.image_ratio_options.landscape" }
        ],
        "default": "portrait"
      },
      { "type": "checkbox", "id": "card_hover_image", "label": "t:settings.product_cards.hover_image", "default": true },
      { "type": "checkbox", "id": "card_show_vendor", "label": "t:settings.product_cards.show_vendor", "default": true },
      { "type": "checkbox", "id": "card_show_rating", "label": "t:settings.product_cards.show_rating", "default": true },
      { "type": "checkbox", "id": "card_show_quick_add", "label": "t:settings.product_cards.show_quick_add", "default": true },
      { "type": "checkbox", "id": "card_show_wishlist", "label": "t:settings.product_cards.show_wishlist", "default": true },
      { "type": "checkbox", "id": "card_show_swatches", "label": "t:settings.product_cards.show_swatches", "default": true },
      { "type": "checkbox", "id": "card_show_sale_badge", "label": "t:settings.product_cards.show_sale_badge", "default": true }
    ]
  },
  {
    "name": "t:settings.cart.name",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings.cart.type",
        "options": [
          { "value": "drawer", "label": "t:settings.cart.type_options.drawer" },
          { "value": "page", "label": "t:settings.cart.type_options.page" }
        ],
        "default": "drawer"
      },
      { "type": "checkbox", "id": "cart_show_gift_note", "label": "t:settings.cart.show_gift_note", "default": true },
      { "type": "text", "id": "free_shipping_threshold", "label": "t:settings.cart.free_shipping_threshold", "info": "t:settings.cart.free_shipping_threshold_info", "default": "150" }
    ]
  },
  {
    "name": "t:settings.wishlist.name",
    "settings": [
      { "type": "checkbox", "id": "wishlist_enable", "label": "t:settings.wishlist.enable", "default": true },
      { "type": "text", "id": "wishlist_page_url", "label": "t:settings.wishlist.page_url", "info": "t:settings.wishlist.page_url_info", "default": "/pages/wishlist" }
    ]
  },
  {
    "name": "t:settings.social.name",
    "settings": [
      { "type": "url", "id": "social_instagram_link", "label": "Instagram" },
      { "type": "url", "id": "social_facebook_link", "label": "Facebook" },
      { "type": "url", "id": "social_pinterest_link", "label": "Pinterest" },
      { "type": "url", "id": "social_tiktok_link", "label": "TikTok" },
      { "type": "url", "id": "social_youtube_link", "label": "YouTube" },
      { "type": "url", "id": "social_x_link", "label": "X" }
    ]
  },
  {
    "name": "t:settings.favicon.name",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "t:settings.favicon.image" }
    ]
  },
  {
    "name": "t:settings.analytics.name",
    "settings": [
      {
        "type": "text",
        "id": "ga4_measurement_id",
        "label": "t:settings.analytics.ga4_measurement_id",
        "info": "t:settings.analytics.ga4_measurement_id_info",
        "placeholder": "G-XXXXXXXXXX"
      }
    ]
  }
]
