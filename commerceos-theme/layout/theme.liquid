<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {% render 'meta-tags' %}
    {% render 'google-analytics' %}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% render 'css-variables' %}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'mega-menu.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'slideshow.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'collection-filters.js' | asset_url }}" defer="defer"></script>

    <script>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>

  <body class="template-{{ request.page_type | handleize }}">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'quick-add-modal' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div class="page-overlay" data-page-overlay hidden></div>

    <script>
      window.ASTER = window.ASTER || {};
      window.ASTER.routes = {
        cart_add_url: {{ routes.cart_add_url | json }},
        cart_change_url: {{ routes.cart_change_url | json }},
        cart_update_url: {{ routes.cart_update_url | json }},
        cart_url: {{ routes.cart_url | json }},
        predictive_search_url: {{ routes.predictive_search_url | json }},
        root_url: {{ routes.root_url | json }}
      };
      window.ASTER.settings = {
        wishlistEnabled: {{ settings.wishlist_enable | json }},
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }}
      };
      window.ASTER.strings = {
        addedToWishlist: {{ 'products.product.added_to_wishlist' | t | json }},
        removedFromWishlist: {{ 'products.product.removed_from_wishlist' | t | json }},
        addToWishlist: {{ 'wishlist.add' | t | json }},
        removeFromWishlist: {{ 'wishlist.remove' | t | json }},
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        noResultsTemplate: {{ 'general.search.no_results' | t: terms: '__TERM__' | json }}
      };
    </script>
  </body>
</html>
