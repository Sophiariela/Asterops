{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', name: 'cart', size: 20 %}
{%- endcomment -%}
{%- liquid
  assign size = size | default: 20
-%}
<svg class="icon icon--{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'cart' -%}
      <path d="M4 6h2l1.6 10.2a2 2 0 0 0 2 1.8h7.4a2 2 0 0 0 2-1.7L20.2 9H6.2" />
      <circle cx="10" cy="20.5" r="1" fill="currentColor" stroke="none" />
      <circle cx="17" cy="20.5" r="1" fill="currentColor" stroke="none" />
    {%- when 'search' -%}
      <circle cx="10.5" cy="10.5" r="6.5" />
      <line x1="20" y1="20" x2="15.2" y2="15.2" />
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="3.5" />
      <path d="M4.5 20c1.4-3.6 4.4-5.5 7.5-5.5s6.1 1.9 7.5 5.5" />
    {%- when 'menu' -%}
      <line x1="3.5" y1="6.5" x2="20.5" y2="6.5" />
      <line x1="3.5" y1="12" x2="20.5" y2="12" />
      <line x1="3.5" y1="17.5" x2="20.5" y2="17.5" />
    {%- when 'close' -%}
      <line x1="5" y1="5" x2="19" y2="19" />
      <line x1="19" y1="5" x2="5" y2="19" />
    {%- when 'chevron-down' -%}
      <polyline points="5,8.5 12,15.5 19,8.5" />
    {%- when 'chevron-up' -%}
      <polyline points="5,15.5 12,8.5 19,15.5" />
    {%- when 'chevron-left' -%}
      <polyline points="15,5 8,12 15,19" />
    {%- when 'chevron-right' -%}
      <polyline points="9,5 16,12 9,19" />
    {%- when 'plus' -%}
      <line x1="12" y1="4.5" x2="12" y2="19.5" />
      <line x1="4.5" y1="12" x2="19.5" y2="12" />
    {%- when 'minus' -%}
      <line x1="4.5" y1="12" x2="19.5" y2="12" />
    {%- when 'check' -%}
      <polyline points="4.5,12.5 9.5,17.5 19.5,6.5" />
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-9.8-9.4C.7 7 2.4 3.6 6 3.1c2-.3 4 .7 6 3 2-2.3 4-3.3 6-3 3.6.5 5.3 3.9 3.8 7.5C19.5 15.4 12 20 12 20z" />
    {%- when 'heart-filled' -%}
      <path d="M12 20s-7.5-4.6-9.8-9.4C.7 7 2.4 3.6 6 3.1c2-.3 4 .7 6 3 2-2.3 4-3.3 6-3 3.6.5 5.3 3.9 3.8 7.5C19.5 15.4 12 20 12 20z" fill="currentColor" />
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.4 5.9.7-4.3 4.1 1.1 5.9L12 16.7l-5.3 2.9 1.1-5.9-4.3-4.1 5.9-.7z" />
    {%- when 'star-filled' -%}
      <path d="M12 3.5l2.6 5.4 5.9.7-4.3 4.1 1.1 5.9L12 16.7l-5.3 2.9 1.1-5.9-4.3-4.1 5.9-.7z" fill="currentColor" />
    {%- when 'truck' -%}
      <rect x="2.5" y="7" width="11" height="8" rx="1" />
      <path d="M13.5 10h4l3 3v2h-7z" />
      <circle cx="7" cy="18" r="1.6" />
      <circle cx="17" cy="18" r="1.6" />
    {%- when 'filter' -%}
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
      <circle cx="9" cy="7" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="15" cy="12" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="11" cy="17" r="1.6" fill="currentColor" stroke="none" />
    {%- when 'grid' -%}
      <rect x="3.5" y="3.5" width="7" height="7" />
      <rect x="13.5" y="3.5" width="7" height="7" />
      <rect x="3.5" y="13.5" width="7" height="7" />
      <rect x="13.5" y="13.5" width="7" height="7" />
    {%- when 'share' -%}
      <circle cx="18" cy="5.5" r="2.2" />
      <circle cx="6" cy="12" r="2.2" />
      <circle cx="18" cy="18.5" r="2.2" />
      <line x1="8" y1="11" x2="16" y2="6.7" />
      <line x1="8" y1="13" x2="16" y2="17.3" />
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="4" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17" cy="7" r="0.8" fill="currentColor" stroke="none" />
    {%- when 'facebook' -%}
      <path d="M14 21v-7h2.4l.4-3H14V8.8c0-.9.3-1.5 1.6-1.5H17V4.6c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V11H8.5v3H11v7z" fill="currentColor" stroke="none" />
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="8.5" />
      <path d="M10 18c.6-2.5 1.3-5.3 1.3-5.3S11 12 11 11a1.7 1.7 0 0 1 3.4 0c0 1-.6 2.5-1 3.9-.3 1 .5 1.9 1.5 1.9 1.8 0 3-2.3 3-5 0-2.1-1.5-3.7-4.1-3.7-3 0-4.8 2.2-4.8 4.5 0 .8.3 1.4.7 1.8" />
    {%- when 'tiktok' -%}
      <path d="M14 3.5c.5 2 2 3.4 4 3.6v2.7a6.6 6.6 0 0 1-4-1.3v6.2a4.7 4.7 0 1 1-4-4.6v2.8a2 2 0 1 0 1.6 2V3.5z" fill="currentColor" stroke="none" />
    {%- when 'youtube' -%}
      <rect x="2.5" y="6" width="19" height="12" rx="3" />
      <polygon points="10.5,9.5 15.5,12 10.5,14.5" fill="currentColor" stroke="none" />
    {%- when 'x-social' -%}
      <line x1="5" y1="5" x2="19" y2="19" />
      <line x1="19" y1="5" x2="5" y2="19" />
    {%- when 'whatsapp' -%}
      <path d="M12 3.5a8.4 8.4 0 0 0-7.2 12.7L3.5 20.5l4.4-1.3A8.4 8.4 0 1 0 12 3.5z" />
      <path d="M8.7 8.4c.2-.5.4-.5.6-.5h.5c.2 0 .4 0 .5.4.2.5.6 1.6.7 1.7.1.1.1.3 0 .4-.1.2-.2.3-.3.5-.2.2-.3.3-.1.5.8 1.3 1.6 1.8 2.9 2.4.2.1.3.1.4-.1.2-.2.5-.6.7-.8.2-.2.3-.1.5 0 .2.1 1.4.7 1.7.8.2.1.3.1.4.2.1.2.1.9-.2 1.4-.3.5-1.4 1-2 1-1.8.1-3.7-.8-5.2-2.2-1.3-1.3-2.1-2.7-2.4-3.9-.2-.7 0-1.4.4-1.8z" fill="currentColor" stroke="none" />
  {%- endcase -%}
</svg>
