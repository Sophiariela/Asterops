{%- comment -%}
  Google Analytics 4 (gtag.js). Only renders when a Measurement ID is set in
  Theme Settings → Analytics. No ID is hardcoded — nothing loads until a
  merchant fills in Theme Settings → Analytics → Google Analytics 4 Measurement ID.
  Usage: {% render 'google-analytics' %} (already conditionally included from layout/theme.liquid)
{%- endcomment -%}
{%- if settings.ga4_measurement_id != blank -%}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.ga4_measurement_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', {{ settings.ga4_measurement_id | json }});
  </script>
{%- endif -%}
