{%- comment -%}
  Cart line items + free-shipping progress + gift note. Assumes cart.item_count > 0.
{%- endcomment -%}
{%- if settings.free_shipping_threshold != blank -%}
  {%- assign threshold_cents = settings.free_shipping_threshold | times: 100 -%}
  {%- assign remaining_cents = threshold_cents | minus: cart.total_price -%}
  <div class="cart-progress">
    {%- if remaining_cents > 0 -%}
      {%- assign remaining_money = remaining_cents | money -%}
      <p>{{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}</p>
    {%- else -%}
      <p>{{ 'cart.free_shipping_reached' | t }}</p>
    {%- endif -%}
    <div class="cart-progress__bar">
      <div class="cart-progress__bar-fill" style="width: {{ cart.total_price | times: 100.0 | divided_by: threshold_cents | at_most: 100 }}%;"></div>
    </div>
  </div>
{%- endif -%}

<ul class="cart-lines" role="list">
  {%- for item in cart.items -%}
    <li class="cart-line">
      <a href="{{ item.url }}" class="cart-line__image">
        <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | default: item.title | escape }}" loading="lazy">
      </a>
      <div class="cart-line__details">
        <h3 class="cart-line__title"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
        {%- if item.variant.title != 'Default Title' -%}
          <p class="cart-line__variant">{{ item.variant.title }}</p>
        {%- endif -%}
        {%- comment -%} Use the line item's own (possibly discounted) price, not the catalog variant price. {%- endcomment -%}
        <div class="price{% if item.final_price < item.original_price %} price--sale{% endif %}">
          {%- if item.final_price < item.original_price -%}
            <span class="price__sale">{{ item.final_price | money }}</span>
            <span class="price__compare">{{ item.original_price | money }}</span>
          {%- else -%}
            <span class="price__regular">{{ item.final_price | money }}</span>
          {%- endif -%}
        </div>
        <div class="cart-line__footer">
          <div class="quantity-selector">
            <button type="button" data-quantity-decrease aria-label="{{ 'products.product.quantity' | t }} -">{% render 'icon', name: 'minus', size: 12 %}</button>
            <input type="number" value="{{ item.quantity }}" min="0" inputmode="numeric" data-quantity-input data-cart-line-quantity="{{ forloop.index }}" aria-label="{{ 'cart.quantity' | t }}">
            <button type="button" data-quantity-increase aria-label="{{ 'products.product.quantity' | t }} +">{% render 'icon', name: 'plus', size: 12 %}</button>
          </div>
          <button type="button" class="cart-line__remove" data-cart-remove="{{ forloop.index }}">{{ 'cart.remove' | t }}</button>
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>

{%- if settings.cart_show_gift_note -%}
  <details class="accordion">
    <summary><span>{{ 'cart.gift_note' | t }}</span>{% render 'icon', name: 'chevron-down', size: 14 %}</summary>
    <div class="accordion__content">
      <textarea class="field" data-cart-note placeholder="{{ 'cart.gift_note_placeholder' | t }}">{{ cart.note }}</textarea>
    </div>
  </details>
{%- endif -%}
