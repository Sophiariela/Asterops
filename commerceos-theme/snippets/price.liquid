{%- comment -%}
  Renders a product/variant price with compare-at strike-through and "from" support.
  Accepts: product, variant, show_from (bool)
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price | default: product.price_min
  assign compare_at = target.compare_at_price
  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif
  assign show_from = show_from | default: false
  if show_from and product.price_varies
    assign show_from = true
  else
    assign show_from = false
  endif
-%}
<div class="price {% if on_sale %}price--sale{% endif %}">
  {%- if show_from -%}
    <span class="price__from">{{ 'products.product.from_price' | t: price: price | money }}</span>
  {%- else -%}
    {%- if on_sale -%}
      <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
      <span class="price__sale">{{ price | money }}</span>
      <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
      <span class="price__compare">{{ compare_at | money }}</span>
    {%- else -%}
      <span class="price__regular">{{ price | money }}</span>
    {%- endif -%}
  {%- endif -%}
</div>
