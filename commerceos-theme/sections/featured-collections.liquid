<div class="section container">
  <div class="section__header">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  <div class="grid grid--cols-{{ section.blocks.size | at_most: 2 }} grid--desktop-{{ section.blocks.size | at_most: 4 }}">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <a href="{{ collection.url }}" class="featured-collection-card" {{ block.shopify_attributes }}>
        <div class="featured-collection-card__media product-card__media product-card__media--portrait">
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" class="product-card__image product-card__image--primary" loading="lazy">
          {%- elsif collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" class="product-card__image product-card__image--primary" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg product-card__image' }}
          {%- endif -%}
        </div>
        <h3 class="featured-collection-card__title">{{ block.settings.title_override | default: collection.title }}</h3>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured-collections.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.featured-collections.settings.heading", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "t:sections.featured-collections.settings.subheading" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.featured-collections.blocks.collection.name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.featured-collections.blocks.collection.settings.collection" },
        { "type": "text", "id": "title_override", "label": "t:sections.featured-collections.blocks.collection.settings.title_override" },
        { "type": "image_picker", "id": "image", "label": "t:sections.featured-collections.blocks.collection.settings.image" }
      ]
    }
  ],
  "default": {
    "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
  },
  "presets": [
    { "name": "t:sections.featured-collections.name", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }
  ]
}
{% endschema %}
