<div class="announcement-bar" {% if section.settings.auto_rotate %}data-announcement-rotate="{{ section.settings.rotate_speed }}"{% endif %}>
  <div class="announcement-bar__inner">
    <div class="announcement-bar__slides">
      {%- for block in section.blocks -%}
        <div class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- assign threshold_money = settings.free_shipping_threshold | times: 100 | money -%}
        <div class="announcement-bar__slide is-active">
          <span>{{ 'sections.announcement_bar.default_message' | t: amount: threshold_money }}</span>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.show_social -%}
      <div class="announcement-bar__social">{% render 'social-icons' %}</div>
    {%- endif -%}
  </div>
</div>

{%- if section.blocks.size > 1 and section.settings.auto_rotate -%}
  <script>
    (function () {
      var slides = document.querySelectorAll('.announcement-bar__slide');
      var index = 0;
      setInterval(function () {
        slides[index].classList.remove('is-active');
        index = (index + 1) % slides.length;
        slides[index].classList.add('is-active');
      }, {{ section.settings.rotate_speed | default: 5 }} * 1000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "settings": [
    { "type": "checkbox", "id": "auto_rotate", "label": "t:sections.announcement-bar.settings.auto_rotate", "default": true },
    { "type": "range", "id": "rotate_speed", "label": "t:sections.announcement-bar.settings.rotate_speed", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "show_social", "label": "t:sections.announcement-bar.settings.show_social", "default": true }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement-bar.blocks.message.name",
      "settings": [
        { "type": "text", "id": "text", "label": "t:sections.announcement-bar.blocks.message.settings.text", "default": "Complimentary shipping on all orders over $150" },
        { "type": "url", "id": "link", "label": "t:sections.announcement-bar.blocks.message.settings.link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message" },
      { "type": "message", "settings": { "text": "Handcrafted in small batches — worldwide shipping" } }
    ]
  }
}
{% endschema %}
