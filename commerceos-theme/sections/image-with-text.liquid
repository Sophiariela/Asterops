<div class="section container">
  <div class="image-with-text image-with-text--{{ section.settings.layout }}">
    <div class="image-with-text__media">
      {%- if section.settings.image -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="image-with-text__content">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.image-with-text.settings.image" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image-with-text.settings.layout",
      "options": [
        { "value": "left", "label": "Image left" },
        { "value": "right", "label": "Image right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "heading", "label": "t:sections.image-with-text.settings.heading", "default": "Crafted with care" },
    { "type": "richtext", "id": "text", "label": "t:sections.image-with-text.settings.text", "default": "<p>Sourced from trusted ateliers and finished by hand.</p>" },
    { "type": "text", "id": "button_label", "label": "t:sections.image-with-text.settings.button_label", "default": "Discover more" },
    { "type": "url", "id": "button_link", "label": "t:sections.image-with-text.settings.button_link" }
  ],
  "presets": [{ "name": "t:sections.image-with-text.name" }]
}
{% endschema %}
