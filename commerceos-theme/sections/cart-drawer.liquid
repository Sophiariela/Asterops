<div class="cart-drawer" data-cart-drawer data-cart-section="{{ section.id }}">
  <div class="cart-drawer__header">
    <h2>{{ 'cart.title' | t }} ({{ cart.item_count }})</h2>
    <button type="button" data-cart-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
  </div>
  <div class="cart-drawer__items">
    {%- if cart.item_count == 0 -%}
      {% render 'cart-empty' %}
    {%- else -%}
      {% render 'cart-items' %}
    {%- endif -%}
  </div>
  {%- if cart.item_count > 0 -%}
    <div class="cart-drawer__footer">
      {% render 'cart-summary', context: 'drawer' %}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-cart.name"
}
{% endschema %}
