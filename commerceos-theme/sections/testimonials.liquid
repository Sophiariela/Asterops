<div class="section container">
  <div class="section__header">
    <h2>{{ section.settings.heading | default: 'sections.testimonials.heading' | t }}</h2>
  </div>
  <div class="testimonials__grid">
    {%- for block in section.blocks -%}
      <div class="testimonial-card" {{ block.shopify_attributes }}>
        {%- if block.settings.avatar -%}
          <div class="testimonial-card__avatar">
            <img src="{{ block.settings.avatar | image_url: width: 112 }}" alt="{{ block.settings.author | escape }}" loading="lazy">
          </div>
        {%- endif -%}
        {%- if block.settings.rating > 0 -%}
          <div class="testimonial-card__stars">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.rating -%}
                {% render 'icon', name: 'star-filled', size: 14 %}
              {%- else -%}
                {% render 'icon', name: 'star', size: 14 %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        <p class="testimonial-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
        <p class="testimonial-card__author">{{ block.settings.author }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.testimonials.settings.heading" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "t:sections.testimonials.blocks.testimonial.settings.quote", "default": "The quality exceeded every expectation. This is the last one I'll ever need." },
        { "type": "text", "id": "author", "label": "t:sections.testimonials.blocks.testimonial.settings.author", "default": "Amara T." },
        { "type": "range", "id": "rating", "label": "t:sections.testimonials.blocks.testimonial.settings.rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "avatar", "label": "t:sections.testimonials.blocks.testimonial.settings.avatar" }
      ]
    }
  ],
  "default": {
    "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
  },
  "presets": [
    { "name": "t:sections.testimonials.name", "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }] }
  ]
}
{% endschema %}
