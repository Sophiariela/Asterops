<footer class="footer" data-section-id="{{ section.id }}" data-section-type="footer">
  {%- if section.settings.show_newsletter -%}
    <div class="footer__newsletter container">
      <h2>{{ section.settings.newsletter_heading }}</h2>
      {%- if section.settings.newsletter_subtext != blank -%}
        <p class="section__subheading">{{ section.settings.newsletter_subtext }}</p>
      {%- endif -%}
      {% render 'newsletter-form', id: 'footer' %}
    </div>
  {%- endif -%}

  <div class="container footer__grid">
    {%- for block in section.blocks -%}
      <div class="footer__column" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'menu' -%}
            <p class="footer__heading">{{ block.settings.heading }}</p>
            <ul class="footer__links">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- when 'text' -%}
            <p class="footer__heading">{{ block.settings.heading }}</p>
            <div class="footer__text">{{ block.settings.text }}</div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
    <div class="footer__column">
      <p class="footer__heading">{{ shop.name }}</p>
      {% render 'social-icons' %}
    </div>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.copyright != blank %} &mdash; {{ section.settings.copyright }}{% endif %}</p>
    {%- if section.settings.show_payment_icons -%}
      <ul class="payment-icons" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "t:sections.footer.settings.show_newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "t:sections.footer.settings.newsletter_heading", "default": "Join the list" },
    { "type": "text", "id": "newsletter_subtext", "label": "t:sections.footer.settings.newsletter_subtext", "default": "Early access to new arrivals and private sales." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:sections.footer.settings.show_payment_icons", "default": true },
    { "type": "text", "id": "copyright", "label": "t:sections.footer.settings.copyright" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.footer.blocks.menu.settings.heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "t:sections.footer.blocks.menu.settings.menu" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.footer.blocks.text.settings.heading", "default": "About" },
        { "type": "richtext", "id": "text", "label": "t:sections.footer.blocks.text.settings.text" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Support" } },
      { "type": "text", "settings": { "heading": "About", "text": "<p>Thoughtfully crafted pieces, made to last.</p>" } }
    ]
  }
}
{% endschema %}
