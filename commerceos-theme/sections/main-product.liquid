{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign active_media_id = current_variant.featured_media.id | default: product.media.first.id
-%}
<div class="container section">
  <div class="product" data-product-info>
    <script type="application/json" data-product-json>{{ product.json }}</script>

    <div class="product-gallery">
      <div class="product-gallery__main" data-product-gallery>
        {%- for media in product.media -%}
          <div class="product-gallery__slide{% if media.id == active_media_id %} is-active{% endif %}" data-gallery-media-id="{{ media.id }}">
            {%- if media.media_type == 'image' -%}
              <img
                src="{{ media.preview_image | image_url: width: 1200 }}"
                srcset="{{ media.preview_image | image_url: width: 700 }} 700w, {{ media.preview_image | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 990px) 50vw, 100vw"
                alt="{{ media.alt | default: product.title | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {% if section.settings.enable_zoom %}data-zoom-enabled{% endif %}
              >
            {%- else -%}
              {{ media | media_tag }}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="product-gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product-gallery__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="product-gallery__thumb{% if media.id == active_media_id %} is-active{% endif %}" data-gallery-thumb-id="{{ media.id }}" aria-label="{{ 'general.accessibility.next_slide' | t }} {{ forloop.index }}">
              <img src="{{ media.preview_image | image_url: width: 120 }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              {%- if section.settings.show_vendor and product.vendor != blank -%}
                <p class="product-info__vendor">{{ product.vendor }}</p>
              {%- endif -%}
              <h1 class="product-info__title">{{ product.title }}</h1>
            </div>

          {%- when 'rating' -%}
            <div {{ block.shopify_attributes }}>{% render 'product-rating', product: product %}</div>

          {%- when 'price' -%}
            <div class="product-info__price" data-product-price {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant %}
            </div>
            <div class="product-info__stock" data-product-stock {% unless current_variant.available %}hidden{% endunless %}>
              <span class="product-info__stock-dot"></span>
              <span>{{ 'products.product.in_stock' | t }}</span>
            </div>

          {%- when 'variant_picker' -%}
            <form data-product-form id="product-form-{{ section.id }}" action="/cart/add" method="post" {{ block.shopify_attributes }}>
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-variant-id>
              {%- for option in product.options_with_values -%}
                <div class="product-info__option">
                  <p class="product-info__option-label"><span>{{ option.name }}</span><span data-selected-value>{{ option.selected_value }}</span></p>
                  <div class="quick-add-form__values">
                    {%- for value in option.values -%}
                      <label class="option-pill">
                        <input
                          type="radio"
                          name="option-{{ option.position }}"
                          value="{{ value | escape }}"
                          {% if value == option.selected_value %}checked{% endif %}
                          data-product-option
                          data-option-position="{{ option.position }}"
                        >
                        <span>{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}

              {%- assign quantity_block_present = false -%}
              {%- for b in section.blocks -%}{%- if b.type == 'quantity_selector' -%}{%- assign quantity_block_present = true -%}{%- endif -%}{%- endfor -%}
              {%- unless quantity_block_present -%}
                <input type="hidden" name="quantity" value="1">
              {%- endunless -%}
            </form>

          {%- when 'quantity_selector' -%}
            <div class="product-info__option" {{ block.shopify_attributes }}>
              <p class="product-info__option-label">{{ 'products.product.quantity' | t }}</p>
              <div class="quantity-selector">
                <button type="button" data-quantity-decrease aria-label="{{ 'products.product.quantity' | t }} -">{% render 'icon', name: 'minus', size: 14 %}</button>
                <input type="number" form="product-form-{{ section.id }}" name="quantity" value="1" min="1" inputmode="numeric" data-quantity-input>
                <button type="button" data-quantity-increase aria-label="{{ 'products.product.quantity' | t }} +">{% render 'icon', name: 'plus', size: 14 %}</button>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product-info__actions" {{ block.shopify_attributes }}>
              <div class="product-info__row">
                <button type="submit" form="product-form-{{ section.id }}" class="button button--primary button--full" data-product-submit>
                  <span data-button-text>{{ 'products.product.add_to_cart' | t }}</span>
                  {% render 'loading-spinner' %}
                </button>
                {%- if settings.wishlist_enable -%}
                  <button type="button" class="button button--secondary" data-wishlist-toggle data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}" aria-label="{{ 'wishlist.add' | t }}">
                    {% render 'icon', name: 'heart', size: 18 %}
                  </button>
                {%- endif -%}
              </div>
              <p class="product-info__form-error" data-product-form-error hidden></p>
            </div>

          {%- when 'sku' -%}
            {%- if current_variant.sku != blank -%}
              <p class="product-info__meta" {{ block.shopify_attributes }}>{{ 'products.product.sku' | t: sku: current_variant.sku }}</p>
            {%- endif -%}

          {%- when 'description' -%}
            <div class="product-info__description rich-text__body" {{ block.shopify_attributes }}>{{ product.description }}</div>

          {%- when 'collapsible_tab' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.heading }}</span>
                {% render 'icon', name: 'chevron-down', size: 14 %}
              </summary>
              <div class="accordion__content">
                {{ block.settings.page.content | default: block.settings.content }}
              </div>
            </details>

          {%- when 'share' -%}
            <div class="product-info__share" {{ block.shopify_attributes }}>
              {% render 'social-share', product: product %}
            </div>

          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('click', function (event) {
    var share = event.target.closest('[data-share-trigger]');
    if (share && navigator.share) {
      navigator.share({ url: share.getAttribute('data-url'), title: document.title });
    } else if (share) {
      navigator.clipboard.writeText(share.getAttribute('data-url'));
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "settings": [
    { "type": "checkbox", "id": "enable_zoom", "label": "t:sections.main-product.settings.enable_zoom", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "t:sections.main-product.settings.show_vendor", "default": true }
  ],
  "blocks": [
    { "type": "title", "name": "t:sections.main-product.blocks.title.name", "limit": 1 },
    { "type": "rating", "name": "t:sections.main-product.blocks.rating.name", "limit": 1 },
    { "type": "price", "name": "t:sections.main-product.blocks.price.name", "limit": 1 },
    { "type": "variant_picker", "name": "t:sections.main-product.blocks.variant_picker.name", "limit": 1 },
    { "type": "quantity_selector", "name": "t:sections.main-product.blocks.quantity_selector.name", "limit": 1 },
    { "type": "buy_buttons", "name": "t:sections.main-product.blocks.buy_buttons.name", "limit": 1 },
    { "type": "sku", "name": "t:sections.main-product.blocks.sku.name", "limit": 1 },
    { "type": "description", "name": "t:sections.main-product.blocks.description.name", "limit": 1 },
    {
      "type": "collapsible_tab",
      "name": "t:sections.main-product.blocks.collapsible_tab.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.main-product.blocks.collapsible_tab.settings.heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "t:sections.main-product.blocks.collapsible_tab.settings.content" },
        { "type": "page", "id": "page", "label": "t:sections.main-product.blocks.collapsible_tab.settings.page" }
      ]
    },
    { "type": "share", "name": "t:sections.main-product.blocks.share.name", "limit": 1 },
    {
      "type": "custom_liquid",
      "name": "t:sections.main-product.blocks.custom_liquid.name",
      "settings": [{ "type": "liquid", "id": "custom_liquid", "label": "t:sections.main-product.blocks.custom_liquid.settings.custom_liquid" }]
    }
  ],
  "default": {
    "blocks": [
      { "type": "title" },
      { "type": "rating" },
      { "type": "price" },
      { "type": "variant_picker" },
      { "type": "quantity_selector" },
      { "type": "buy_buttons" },
      { "type": "sku" },
      { "type": "description" },
      { "type": "collapsible_tab", "settings": { "heading": "Shipping & returns" } },
      { "type": "share" }
    ]
  }
}
{% endschema %}
