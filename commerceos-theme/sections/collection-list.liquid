<div class="section container">
  {%- if section.settings.heading != blank -%}
    <div class="section__header"><h2>{{ section.settings.heading }}</h2></div>
  {%- endif -%}

  <div class="collection-list" style="--cl-desktop-cols: {{ section.settings.columns_desktop }};">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <a href="{{ collection.url }}" class="collection-list__item" {{ block.shopify_attributes }}>
        <div class="collection-list__media">
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ collection.title | escape }}" loading="lazy">
          {%- elsif collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 700 }}" alt="{{ collection.title | escape }}" loading="lazy">
          {%- else -%}
            {{ 'collection-2' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <p class="collection-list__title">{{ collection.title }}</p>
        <span class="collection-list__count">{{ collection.products_count }} items</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection-list.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.collection-list.settings.heading", "default": "Explore the edit" },
    { "type": "range", "id": "columns_desktop", "label": "t:sections.collection-list.settings.columns_desktop", "min": 3, "max": 6, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection-list.blocks.collection.name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.collection-list.blocks.collection.settings.collection" },
        { "type": "image_picker", "id": "image", "label": "t:sections.collection-list.blocks.collection.settings.image" }
      ]
    }
  ],
  "default": {
    "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
  },
  "presets": [
    { "name": "t:sections.collection-list.name", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }
  ]
}
{% endschema %}
