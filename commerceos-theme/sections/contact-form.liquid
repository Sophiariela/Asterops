<div class="container section">
  <div class="section__header">
    <h1>{{ section.settings.heading | default: page.title }}</h1>
  </div>

  {%- form 'contact', id: 'ContactForm' -%}
    <div class="contact-form">
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" role="status">{{ 'sections.contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form-status form-status--error" role="alert">{{ 'sections.contact.error' | t }}</p>
      {%- endif -%}

      <div>
        <label for="ContactFormName">{{ 'sections.contact.name' | t }}</label>
        <input type="text" id="ContactFormName" class="field" name="contact[name]" value="{{ form.name }}">
      </div>
      <div>
        <label for="ContactFormEmail">{{ 'sections.contact.email' | t }} *</label>
        <input type="email" id="ContactFormEmail" class="field" name="contact[email]" value="{{ form.email }}" required>
      </div>
      <div>
        <label for="ContactFormPhone">{{ 'sections.contact.phone' | t }}</label>
        <input type="tel" id="ContactFormPhone" class="field" name="contact[phone]" value="{{ form.phone }}">
      </div>
      <div>
        <label for="ContactFormMessage">{{ 'sections.contact.message' | t }} *</label>
        <textarea id="ContactFormMessage" class="field" name="contact[body]" required>{{ form.body }}</textarea>
      </div>
      <button type="submit" class="button button--primary">{{ 'sections.contact.submit' | t }}</button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.contact-form.settings.heading" }
  ]
}
{% endschema %}
