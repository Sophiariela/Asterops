{%- comment -%}
  FAQ section — schema-driven accordion. Add/remove/reorder "Question" blocks from the theme editor.
  Reuses the .accordion / .accordion__content styles already defined in assets/base.css.
{%- endcomment -%}
<div class="section container faq">
  <div class="section__header">
    <h2>{{ section.settings.heading | default: 'sections.faq.heading' | t }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="section__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="faq__list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'question' -%}
        <details class="accordion faq__item" {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            {% render 'icon', name: 'chevron-down', size: 14 %}
          </summary>
          <div class="accordion__content faq__answer rich-text__body">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.faq.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.faq.settings.heading", "default": "Frequently asked questions" },
    { "type": "richtext", "id": "subheading", "label": "t:sections.faq.settings.subheading" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.blocks.question.name",
      "settings": [
        { "type": "text", "id": "question", "label": "t:sections.faq.blocks.question.settings.question", "default": "What is your question?" },
        { "type": "richtext", "id": "answer", "label": "t:sections.faq.blocks.question.settings.answer", "default": "<p>Share the answer to the question here.</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "question",
        "settings": {
          "question": "How long does shipping take?",
          "answer": "<p>Orders are processed within 1-2 business days and typically arrive within 3-7 business days, depending on your location. You'll receive a tracking link by email as soon as your order ships.</p>"
        }
      },
      {
        "type": "question",
        "settings": {
          "question": "What is your return policy?",
          "answer": "<p>We accept returns within 30 days of delivery for unused items in their original packaging. Visit our returns page or contact us to start the process.</p>"
        }
      },
      {
        "type": "question",
        "settings": {
          "question": "Which payment methods do you accept?",
          "answer": "<p>We accept all major credit cards and the local payment methods shown at checkout. All transactions are securely processed by Shopify.</p>"
        }
      },
      {
        "type": "question",
        "settings": {
          "question": "How can I track my order?",
          "answer": "<p>Once your order ships you'll receive an email with a tracking number and link. You can also check order status anytime from your account.</p>"
        }
      }
    ]
  },
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders are processed within 1-2 business days and typically arrive within 3-7 business days, depending on your location. You'll receive a tracking link by email as soon as your order ships.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We accept returns within 30 days of delivery for unused items in their original packaging. Visit our returns page or contact us to start the process.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Which payment methods do you accept?",
            "answer": "<p>We accept all major credit cards and the local payment methods shown at checkout. All transactions are securely processed by Shopify.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>Once your order ships you'll receive an email with a tracking number and link. You can also check order status anytime from your account.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
