{%- assign collection = section.settings.collection -%}
<div class="section container">
  <div class="section__header section__header--split">
    <div>
      <h2>{{ section.settings.heading | default: collection.title }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    {%- if collection -%}
      <a href="{{ collection.url }}" class="section__link">{{ 'sections.featured_collections.view_all' | t }}</a>
    {%- endif -%}
  </div>

  <div class="product-grid" style="--pg-desktop-cols: {{ section.settings.columns_desktop }};">
    {%- if collection -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <div class="product-card">
          <div class="product-card__media product-card__media--{{ settings.card_image_ratio }}">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product-card__image' }}</div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured-collections.name",
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:sections.featured-collections.blocks.collection.settings.collection" },
    { "type": "text", "id": "heading", "label": "t:sections.featured-collections.settings.heading" },
    { "type": "text", "id": "subheading", "label": "t:sections.featured-collections.settings.subheading" },
    { "type": "range", "id": "products_to_show", "label": "t:sections.main-collection-product-grid.settings.products_per_page", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "t:sections.main-collection-product-grid.settings.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "t:sections.featured-collections.name" }]
}
{% endschema %}
