# Notion CRM integration (optional secondary lead export) — see docs/notion-crm-setup.md.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database — Postgres connection strings (Neon: pooled for runtime, direct for migrations)
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Admin panel auth
ADMIN_SESSION_SECRET=generate-a-long-random-string
ADMIN_SEED_EMAIL=you@example.com
ADMIN_SEED_PASSWORD=choose-a-strong-password

# Public site URL — usado em metadata canônica, sitemap e robots.
NEXT_PUBLIC_SITE_URL="https://aster.studio"

# Notificação de novo pedido por e-mail (opcional — ver src/lib/email.ts).
# Sem RESEND_API_KEY o envio é ignorado e o pedido segue gravado no banco.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
INQUIRY_FROM_EMAIL="Aster <contato@aster.studio>"
INQUIRY_NOTIFY_EMAIL=you@example.com
