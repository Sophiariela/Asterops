# Copie para .env e substitua TODO valor de exemplo.
#
# Use um arquivo só (.env). Não crie .env.local: o Next dá precedência a ele,
# mas o Prisma CLI e o `tsx` do seed carregam apenas .env — manter os dois
# fazia o seed não ver ADMIN_SEED_* e deixava segredo duplicado sem efeito.
#
# Valor deixado como "xxxx" é tratado como NÃO configurado (ver src/lib/env.ts),
# então um placeholder esquecido desliga o recurso em vez de gerar chamada de
# API que falha a cada envio.

# --- Obrigatório ---

# Banco — Postgres. No Neon: a URL pooled no runtime, a direta para migração.
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Sessão do painel. Gere algo longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=generate-a-long-random-string

# --- Opcional ---

# Usuário do painel criado/atualizado por `npm run db:seed`.
# Sem os dois, o seed apenas avisa e segue — não cria usuário.
ADMIN_SEED_EMAIL=you@example.com
ADMIN_SEED_PASSWORD=choose-a-strong-password

# URL pública — usada em metadata canônica, sitemap e robots.
NEXT_PUBLIC_SITE_URL="https://aster.studio"

# Notificação de novo pedido por e-mail (src/lib/email.ts).
# Sem RESEND_API_KEY o envio é ignorado; o pedido continua gravado no banco.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
INQUIRY_FROM_EMAIL="Aster <hello@aster.studio>"
INQUIRY_NOTIFY_EMAIL=you@example.com

# Espelho do pedido no Notion (src/lib/notion.ts) — ver docs/notion-crm-setup.md.
# Secundário e best-effort: o banco é a fonte de verdade.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
