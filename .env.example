VITE_API_URL="http://localhost:4000/api"

# Canonical origin used for generated public WebOS site links
# (https://<this>/site/<slug>). Defaults to the current production Vercel
# URL if unset — only set this once a real custom domain is added in
# Vercel AND its DNS is actually verified (see Project → Settings →
# Domains), not just registered.
VITE_PUBLIC_SITE_URL="https://asterops-lime.vercel.app"
